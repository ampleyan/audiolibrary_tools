# dj-prep-tool/.env.pg.example
# Copy to .env.pg and fill in real values. Never commit .env.pg.

# "local"  → Unix socket /var/run/postgresql (Pi only, no password)
# "remote" → TLS to kodisrv, sslmode=verify-full
DATABASE_MODE=local

# Required when DATABASE_MODE=remote
# Format: postgresql://audiotool@192.168.129.39:5432/audiotool
DATABASE_URL=postgresql://audiotool@192.168.129.39:5432/audiotool

# Password for the audiotool role (remote mode only)
# On Pi, also exported so the importer script can connect remotely if needed
AUDIOTOOL_PASSWORD=
