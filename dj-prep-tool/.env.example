# dj-prep-tool/.env.example
# Copy to .env and fill in real values. Never commit .env.
#
# ── HOW TO RUN ────────────────────────────────────────────────────────────────
#
# Mac / Windows (Postgres runs somewhere, reachable via TCP):
#   docker compose up -d --build
#   Needs: AUDIOTOOL_PASSWORD
#
# Raspberry Pi 5 (Postgres socket on same host):
#   docker compose -f docker-compose.yml -f docker-compose.rpi5.yml up -d --build
#   Needs: AUDIOTOOL_PASSWORD
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the audiotool Postgres role — required on all platforms
AUDIOTOOL_PASSWORD=

# TCP connection URL — PostgreSQL audiotool database hosted on Kodi
# Pi uses DATABASE_MODE=local (socket) via docker-compose.rpi5.yml, so this
# is ignored there.
DATABASE_URL=postgresql://audiotool@kodisrv:5432/audiotool

# SSL mode for remote connections: "disable" for LAN, "verify-full" for internet
DATABASE_SSLMODE=disable

# ── Sockseek ──────────────────────────────────────────────────────────────────
# Local Windows Compose runs Sockseek in the local sockseek container.
SOCKSEEK_URL=http://sockseek:5030

# Soulseek account credentials — used by the sockseek container
SOCKSEEK_USERNAME=
SOCKSEEK_PASSWORD=

# ── External services (all optional) ─────────────────────────────────────────
# Spotify — pre-fills Settings page
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cosine API key — pre-fills Settings page
COSINE_API_KEY=

# Telegram — pre-fills Settings page
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Windows Compose runs Beets in the local beets container.
BEETS_URL=http://beets:8337

# ── Music folders ─────────────────────────────────────────────────────────────
# Inbox (new downloads land here) and archive (processed library).
# Windows local music folders.
MUSIC_INBOX_DIR=E:/MUSIC/TESTWAV
MUSIC_ARCHIVE_DIR=E:/MUSIC/RECENT
# Pi paths are hardcoded in docker-compose.rpi5.yml and override these.

# ── Misc ──────────────────────────────────────────────────────────────────────
# YouTube OAuth (Create Playlist feature)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/youtube/callback

# YouTube cookies file path inside the container (for private/age-restricted)
YT_COOKIES_FILE=

# Path remapping — if your music files are mounted at a different path inside
# the container than Rekordbox sees on the host, set these to remap on export
PATH_MAP_FROM=
PATH_MAP_TO=

# Rekordbox XML path inside the container
DJ_PREP_REKORDBOX_XML=
