# dj-prep-tool/.env.example
# Copy to .env and fill in real values. Never commit .env.
#
# ── HOW TO RUN ────────────────────────────────────────────────────────────────
#
# Mac / Windows (Postgres runs somewhere, reachable via TCP):
#   docker compose up -d
#   Needs: DATABASE_URL, AUDIOTOOL_PASSWORD
#
# Raspberry Pi 5 (Postgres socket on same host):
#   docker compose -f docker-compose.yml -f docker-compose.rpi5.yml up -d
#   Needs: AUDIOTOOL_PASSWORD  (DATABASE_URL ignored in local mode)
#
# ─────────────────────────────────────────────────────────────────────────────

# Password for the audiotool Postgres role — required on all platforms
AUDIOTOOL_PASSWORD=

# TCP connection URL — used when DATABASE_MODE=remote (Mac/Windows default)
# The rpi5 compose overrides DATABASE_MODE to "local" (socket), so this is
# ignored on Pi but still useful if you want to run remotely from the Pi too.
DATABASE_URL=postgresql://audiotool@host.docker.internal:5432/audiotool

# SSL mode for remote connections: "disable" for LAN, "verify-full" for internet
DATABASE_SSLMODE=disable

# Sockseek daemon URL — defaults to host.docker.internal:5030 if not set
# Override if sockseek runs on a different host
SOCKSEEK_URL=http://host.docker.internal:5030

# YouTube OAuth (optional — only needed for Create Playlist feature)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/youtube/callback

# Rekordbox XML path inside the container (optional)
# Mount the file in docker-compose.yml volumes and set path here
DJ_PREP_REKORDBOX_XML=
